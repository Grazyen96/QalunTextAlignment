# QuranText environment configuration.
# Copy to `.env` or `.env.local` and adjust. Process/shell environment wins over
# .env.local, which wins over .env. All QURANTEXT_* values are optional overrides
# of the defaults in src/qurantext/config/settings.py. Nothing here is required:
# transcription runs on this computer by default. The Replicate token is needed
# only to transcribe with WhisperX online (QURANTEXT_TRANSCRIBE_ENGINE=whisperx,
# or `--engine whisperx`, or that choice in the window's More options).

# --- Transcription engine -----------------------------------------------------
# local (the default) transcribes on this computer; whisperx uploads the audio
# to WhisperX on Replicate.
# QURANTEXT_TRANSCRIBE_ENGINE=local
# Where recomputable files go, the local speech model (about 110 MB, downloaded
# on first use) among them. Defaults to the platform's cache folder.
# QURANTEXT_CACHE_DIR=

# --- Only for WhisperX transcription via Replicate ----------------------------
REPLICATE_API_TOKEN=

# --- WhisperX transcription (defaults shown) ---------------------------------
# QURANTEXT_WHISPERX_MODEL=victor-upmeet/whisperx:84d2ad2d6194fe98a17d2b60bef1c7f910c46b2f6fd38996ca457afd9c8abfcb
# QURANTEXT_WHISPERX_LANGUAGE=ar
# QURANTEXT_WHISPERX_BATCH_SIZE=64
# QURANTEXT_WHISPERX_VAD_ONSET=0.5
# QURANTEXT_WHISPERX_VAD_OFFSET=0.363
# QURANTEXT_WHISPERX_DEBUG=false
# QURANTEXT_WHISPERX_DIARIZATION=false
# QURANTEXT_WHISPERX_TEMPERATURE=0
# QURANTEXT_WHISPERX_ALIGN_OUTPUT=true
# QURANTEXT_WHISPERX_LANGUAGE_DETECTION_MIN_PROB=0
# QURANTEXT_WHISPERX_LANGUAGE_DETECTION_MAX_TRIES=5

# --- Range matching (first/last ayah detection) ------------------------------
# QURANTEXT_RANGE_HEAD_WORDS=80
# QURANTEXT_RANGE_TAIL_WORDS=80
# QURANTEXT_RANGE_SEARCH_RANGE=20
# QURANTEXT_RANGE_LOW_CONF=0.40
# QURANTEXT_RANGE_POSITION_THRESHOLD=0.55
# QURANTEXT_RANGE_POSITION_THRESHOLD_GLOBAL=0.65
# QURANTEXT_RANGE_HIGH_CONF_POSITION=0.75
# QURANTEXT_RANGE_MIN_WORDS_GLOBAL=5

# --- Lecture matching (Quran mentions in lectures) ---------------------------
# QURANTEXT_LECTURE_MAX_SPAN=5
# QURANTEXT_LECTURE_MIN_WINDOW_WORDS=5
# QURANTEXT_LECTURE_MAX_WINDOW_WORDS=35
# QURANTEXT_LECTURE_WINDOW_STEP=3
# QURANTEXT_LECTURE_THRESHOLD=0.78
# QURANTEXT_LECTURE_MIN_MATCHED_WORDS=4
# QURANTEXT_LECTURE_CANDIDATE_LIMIT=25

# --- Video rendering ---------------------------------------------------------
# QURANTEXT_VIDEO_RENDERER=frame
# QURANTEXT_VIDEO_WIDTH=1280
# QURANTEXT_VIDEO_HEIGHT=720
# QURANTEXT_VIDEO_FPS=25
# Gaps up to this many seconds pull the next ayah group back to the previous
# group's end; longer gaps meet in the middle. Avoids black screens between groups.
# QURANTEXT_VIDEO_GAP_MIDPOINT_THRESHOLD=3.0

# --- Legacy word/aya alignment thresholds ------------------------------------
# QURANTEXT_WORD_MATCH_THRESHOLD=0.80
# QURANTEXT_AYA_MATCH_THRESHOLD=0.50
