/venv/
.venv/

# Local environment files
.env
.env.local
.env.*.local

# IDE/editor
.idea/
.vscode/
.continue/

# OS files
.DS_Store
Thumbs.db

# Generated audio/video/subtitle artifacts
*.mp3
*.mp4
*.wav
*.srt
*.ass

# Generated JSON outputs
*.json

# If you want to ignore all generated output folders
output_word/

# Built data store (regenerate with `qurantext build-db`)
/data/*.sqlite
/data/*.sqlite.tmp

# Optional: test/cache/build artifacts
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Generated output tree (renders, match JSON, export packages)
/output/

# Hand-carried deployment copy of the panel + a sample package (build artifact)
/qalun-for-windows/
/qalun-for-windows.zip

# Render intermediates and manual verification scaffolding
/tmp_render_tests/
*.ffmpeg.log
*.silent.mp4

# Media inputs are the user's own; keep them out of the repo regardless of case
/input/lectures/
/input/recitations/
/input/basmala/
vendor/
